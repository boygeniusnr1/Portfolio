---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site-config';

const setupSections = [
	{
		title: 'Basic setup',
		description: 'Connect the Home Assistant app to your home server while your phone is on the same Wi-Fi.',
		steps: [
			{
				title: 'Install Home Assistant',
				description: 'Download the official app from the Apple App Store.',
				link: {
					label: 'Get Home Assistant',
					href: 'https://apps.apple.com/us/app/home-assistant/id1099568401',
				},
			},
			{
				title: 'Connect to your server',
				description: 'Open the app on your home Wi-Fi and select your discovered Home Assistant server. If it is not found, enter 192.168.1.3 as the IP Address',
			},
			{
				title: 'Sign in',
				description: 'Use your Home Assistant username and password on the side of your sensor',
			},
			{
				title: 'Check the connection',
				description: 'Wait for your dashboard to load, then confirm you can see your device under Living Room.',
			},
			{
				title: 'Choose app permissions',
				description: 'Allow local network access when prompted. Enable notifications or location only if you want to use those features.',
			},
		],
	},
	{
		title: 'Access everywhere',
		description: 'Use Tailscale to reach your Home Assistant server securely when you are away from home.',
		steps: [
			{
				title: 'Install Tailscale',
				description: 'Download the official Tailscale app from the Apple App Store.',
				link: {
					label: 'Get Tailscale',
					href: 'https://apps.apple.com/us/app/tailscale/id1470499037',
				},
			},
			{
				title: 'Join your Tailnet',
				description: 'Use the invitation provided to you to join the Tailnet and create an account. Accept the VPN configuration prompt when asked.',
			},
			{
				title: 'Check the Home Assistant server',
				description: 'Make sure the Home Assistant server is connected to the same Tailnet and appears online in Tailscale.',
			},
			{
				title: 'Set the remote address',
				description: 'Set Home Assistant’s external URL to http://homeassistant.tail527a27.ts.net.'
			},
			{
				title: 'Test away from home',
				description: 'Turn off Wi-Fi, connect Tailscale on your phone, and open the Home Assistant app. The server should load without exposing it to the public internet.',
			},
		],
	},
];
---

<BaseLayout
	title={`Device Setup | ${siteConfig.title}`}
	description="Set up the Home Assistant app and access your home securely with Tailscale."
	noIndex={true}
>
	<main class="mx-auto max-w-4xl pb-16">
		<header class="mb-14 max-w-3xl">
			<a href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-neutral-500 transition-colors hover:text-brand-primary dark:text-neutral-400">
				<span aria-hidden="true">←</span> Back home
			</a>
			<h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Set up your device</h1>
			<p class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
				Follow these steps to connect the Home Assistant app at home, then securely reach it from anywhere.
			</p>
		</header>

		<div class="space-y-16">
			{setupSections.map((section) => (
				<section aria-labelledby={section.title.toLowerCase().replaceAll(' ', '-')}>
					<div class="mb-6 max-w-2xl">
						<h2 id={section.title.toLowerCase().replaceAll(' ', '-')} class="text-2xl font-bold tracking-tight sm:text-3xl">
							{section.title}
						</h2>
						<p class="mt-2 leading-relaxed text-neutral-600 dark:text-neutral-400">{section.description}</p>
					</div>

					<ol class="grid gap-3">
						{section.steps.map((step, index) => (
							<li class="grid grid-cols-[2.5rem_1fr] gap-4 rounded-2xl border border-neutral-200 bg-white p-5 shadow-bento dark:border-neutral-800 dark:bg-neutral-900 sm:grid-cols-[3rem_1fr] sm:gap-5 sm:p-6">
								<span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-neutral-100 text-sm font-bold text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 sm:size-12">
									{String(index + 1).padStart(2, '0')}
								</span>
								<div>
									<h3 class="text-lg font-bold">{step.title}</h3>
									<p class="mt-1 leading-relaxed text-neutral-600 dark:text-neutral-400">{step.description}</p>
									{step.link && (
										<a
											href={step.link.href}
											target="_blank"
											rel="noopener noreferrer"
											class="mt-3 inline-flex min-h-11 items-center rounded-full border border-brand-primary/30 px-4 text-sm font-semibold text-brand-primary transition-colors hover:bg-brand-primary/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary dark:border-brand-primary/40"
										>
											{step.link.label}
											<span class="sr-only"> (opens the Apple App Store in a new tab)</span>
										</a>
									)}
								</div>
							</li>
						))}
					</ol>
				</section>
			))}
		</div>
	</main>
</BaseLayout>
